  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/express": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "hbs": "^4.2.0",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "prisma": "^7.3.0"
  }
