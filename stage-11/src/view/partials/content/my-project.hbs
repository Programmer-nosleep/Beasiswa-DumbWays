<section class="py-16">
  <div class="w-full max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <h1 class="text-4xl font-bold text-dark">My Project</h1>

      <form action="/logout" method="POST">
        <button type="submit"
          class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-semibold text-base cursor-pointer transition-all duration-300 bg-white text-dark border-2 border-slate-200 hover:border-primary hover:text-primary">
          Logout
        </button>
      </form>
    </div>

    <div class="bg-white p-10 rounded-2xl shadow-md animate-fade-in-up">
      {{#if user}}
      <p class="text-slate-600">
        You're signed in as <span class="font-semibold text-dark">{{user.name}}</span> ({{user.email}}).
      </p>
      {{else}}
      <p class="text-slate-600">You're signed in.</p>
      {{/if}}
    </div>
  </div>
</section>

