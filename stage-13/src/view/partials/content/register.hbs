<section class="py-16">
  <div class="w-full max-w-[520px] mx-auto px-6">
    <h1 class="text-4xl font-bold mb-8 text-dark">Register</h1>

    <div class="bg-white p-10 rounded-2xl shadow-md animate-fade-in-up">
      {{#if error}}
      <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
        {{error}}
      </div>
      {{/if}}

      <form class="flex flex-col gap-6" action="/register" method="POST">
        <input type="hidden" name="nextUrl" value="{{nextUrl}}">

        <div class="flex flex-col gap-2">
          <label for="name" class="font-semibold text-dark">Name</label>
          <input type="text" id="name" name="name" required placeholder="Your name" value="{{form.name}}"
            class="px-4 py-3.5 border-2 border-slate-200 rounded-lg font-inherit text-base transition-all duration-300 bg-white focus:outline-none focus:border-primary focus:ring-[3px] focus:ring-primary/10">
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="font-semibold text-dark">Email</label>
          <input type="email" id="email" name="email" required placeholder="your@email.com" value="{{form.email}}"
            class="px-4 py-3.5 border-2 border-slate-200 rounded-lg font-inherit text-base transition-all duration-300 bg-white focus:outline-none focus:border-primary focus:ring-[3px] focus:ring-primary/10">
        </div>

        <div class="flex flex-col gap-2">
          <label for="password" class="font-semibold text-dark">Password</label>
          <input type="password" id="password" name="password" required placeholder="Min. 6 characters"
            class="px-4 py-3.5 border-2 border-slate-200 rounded-lg font-inherit text-base transition-all duration-300 bg-white focus:outline-none focus:border-primary focus:ring-[3px] focus:ring-primary/10">
        </div>

        <div class="flex flex-col gap-2">
          <label for="passwordConfirm" class="font-semibold text-dark">Confirm Password</label>
          <input type="password" id="passwordConfirm" name="passwordConfirm" required placeholder="Repeat password"
            class="px-4 py-3.5 border-2 border-slate-200 rounded-lg font-inherit text-base transition-all duration-300 bg-white focus:outline-none focus:border-primary focus:ring-[3px] focus:ring-primary/10">
        </div>

        <button type="submit"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl font-semibold text-base cursor-pointer transition-all duration-300 bg-gradient-to-br from-primary to-secondary text-white shadow-[0_4px_14px_0_rgba(99,102,241,0.4)] hover:-translate-y-0.5 hover:shadow-[0_6px_20px_0_rgba(99,102,241,0.5)]">Create Account</button>
      </form>

      <p class="mt-6 text-sm text-slate-600">
        Already have an account?
        <a href="/login?next={{nextUrlEncoded}}"
          class="font-semibold text-primary hover:text-primary-dark transition-colors duration-300">Login</a>
      </p>
    </div>
  </div>
</section>

