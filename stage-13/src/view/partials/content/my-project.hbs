<section class="py-16">
  <div class="w-full max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <h1 class="text-4xl font-bold text-dark">My Project</h1>

      <a href="/my-project/new"
        class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-semibold text-base cursor-pointer transition-all duration-300 bg-gradient-to-br from-primary to-secondary text-white shadow-[0_4px_14px_0_rgba(99,102,241,0.35)] hover:-translate-y-0.5 hover:shadow-[0_6px_20px_0_rgba(99,102,241,0.45)]">
        Add Project
      </a>
    </div>

    {{#if projects}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {{#each projects}}
      <div class="bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
        <a href="/my-project/{{id}}" class="block">
          <img src="{{imageUrl}}" alt="{{title}}" class="w-full h-48 object-cover">
        </a>
        <div class="p-6">
          <h3 class="text-xl font-bold text-dark mb-1">
            <a href="/my-project/{{id}}" class="hover:text-primary transition-colors duration-300">{{title}}</a>
          </h3>
          <p class="text-sm text-slate-500 mb-3">Durasi: {{duration}} • {{startDate}} - {{endDate}}</p>
          <p class="text-slate-600 mb-4">{{descriptionPreview}}</p>

          {{#if technologies}}
          <div class="flex flex-wrap gap-2 mb-5">
            {{#each technologies}}
            <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-slate-100 text-slate-700">{{this}}</span>
            {{/each}}
          </div>
          {{/if}}

          <div class="flex items-center gap-2">
            <a href="/my-project/{{id}}"
              class="inline-flex items-center justify-center px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-300 bg-slate-100 text-slate-700 hover:bg-slate-200">Detail</a>
            <a href="/my-project/{{id}}/edit"
              class="inline-flex items-center justify-center px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-300 bg-white text-slate-700 border-2 border-slate-200 hover:border-slate-300 hover:bg-slate-50">Edit</a>
            <form action="/my-project/{{id}}/delete" method="POST"
              onsubmit="return confirm('Yakin ingin menghapus project ini?')">
              <button type="submit"
                class="inline-flex items-center justify-center px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-300 bg-red-50 text-red-700 border border-red-200 hover:bg-red-100">Delete</button>
            </form>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="bg-white p-10 rounded-2xl shadow-md animate-fade-in-up">
      <p class="text-slate-600">
        Belum ada project. Klik <span class="font-semibold">Add Project</span> untuk menambahkan project pertama kamu.
      </p>
    </div>
    {{/if}}
  </div>
</section>
