<section class="py-16">
  <div class="w-full max-w-[1100px] mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <h1 class="text-4xl font-bold text-dark">{{project.title}}</h1>

      <div class="flex items-center gap-3">
        <a href="/my-project"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-semibold text-sm cursor-pointer transition-all duration-300 bg-white text-slate-700 border-2 border-slate-200 hover:border-slate-300 hover:bg-slate-50">
          Back
        </a>
        <a href="/my-project/{{project.id}}/edit"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-semibold text-sm cursor-pointer transition-all duration-300 bg-gradient-to-br from-primary to-secondary text-white shadow-[0_4px_14px_0_rgba(99,102,241,0.35)] hover:-translate-y-0.5 hover:shadow-[0_6px_20px_0_rgba(99,102,241,0.45)]">
          Edit
        </a>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-md overflow-hidden animate-fade-in-up">
      <img src="{{project.imageUrl}}" alt="{{project.title}}" class="w-full h-[380px] object-cover">

      <div class="p-10">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-6 py-4">
            <p class="text-sm text-slate-500 mb-1">Durasi</p>
            <p class="text-lg font-semibold text-dark">{{project.duration}}</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-6 py-4">
            <p class="text-sm text-slate-500 mb-1">Tanggal</p>
            <p class="text-lg font-semibold text-dark">{{project.startDate}} - {{project.endDate}}</p>
          </div>
        </div>

        {{#if project.technologies}}
        <div class="mb-8">
          <p class="text-sm text-slate-500 mb-3">Technologies</p>
          <div class="flex flex-wrap gap-2">
            {{#each project.technologies}}
            <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-slate-100 text-slate-700">{{this}}</span>
            {{/each}}
          </div>
        </div>
        {{/if}}

        <div>
          <p class="text-sm text-slate-500 mb-3">Description</p>
          <p class="text-slate-600 whitespace-pre-line leading-relaxed">{{project.description}}</p>
        </div>
      </div>
    </div>
  </div>
</section>
