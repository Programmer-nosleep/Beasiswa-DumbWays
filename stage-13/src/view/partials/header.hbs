      <ul class="nav-menu flex gap-2 md:flex">
        <li>
          <a href="/"
            class="nav-link px-4 py-2 rounded-lg font-medium transition-all duration-300 text-slate-700 hover:bg-slate-100 hover:text-primary {{#if (eq activePage 'home')}}bg-gradient-to-br from-primary to-secondary !text-white{{/if}}">Home</a>
        </li>
        <li>
          <a href="/my-project"
            class="nav-link px-4 py-2 rounded-lg font-medium transition-all duration-300 text-slate-700 hover:bg-slate-100 hover:text-primary {{#if (eq activePage 'my-project')}}bg-gradient-to-br from-primary to-secondary !text-white{{/if}}">My
